<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>panda_bringup</name>
  <version>0.1.0</version>
  <description>Launches the simulated Panda colour pick-and-place demo</description>
  <maintainer email="yashwanth.1341@gmail.com">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>panda_description</exec_depend>
  <exec_depend>panda_controller</exec_depend>
  <exec_depend>panda_moveit</exec_depend>
  <exec_depend>panda_vision</exec_depend>
  <exec_depend>panda_pick_place</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
